# Flora backend — environment template.
# Copy to .env and fill in. Never commit the real .env.

# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated allowed origins for the React Native client / local tools.
# Use * only in development.
CORS_ORIGINS=*

# ---------- Database ----------
# Postgres (RDS in deployed envs, local Docker in dev).
DATABASE_URL=postgresql://flora:flora@localhost:5432/flora?schema=public

# ---------- AWS ----------
AWS_REGION=eu-central-1

# Local dev only. In ECS/Lambda these come from the task/execution role —
# leave them unset there.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------- Cognito (auth) ----------
# Credentials live in Cognito; we keep a thin local User row keyed on `sub`.
COGNITO_USER_POOL_ID=eu-central-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Set ONLY if the Cognito app client was created with a secret.
# If set, auth calls must send a SECRET_HASH; if empty, they must not.
# Decide this before Phase 4 — it changes auth.service.ts.
COGNITO_CLIENT_SECRET=

# ---------- Media (S3 + CloudFront) ----------
# Client uploads directly to S3 with a pre-signed URL issued by this API.
S3_BUCKET=flora-media-dev
S3_PRESIGN_EXPIRY_SECONDS=300

# Optional: serve stored media through CloudFront instead of raw S3 URLs.
CLOUDFRONT_DOMAIN=

# ---------- Diagnosis ----------
# MOCK        -> recognition.adapter returns a stubbed contract-shaped result
# THIRD_PARTY -> external plant-ID API (launch path)
# OWN_MODEL   -> teammate's Lebanese-plant model (FLOR-5)
RECOGNITION_PROVIDER=MOCK

# Results below this confidence get flaggedLowConfidence = true
# and may be escalated to the community. Range 0.0 - 1.0.
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.6
