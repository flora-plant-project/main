{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node --env-file-if-exists=../../.env prisma/seed.js"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "smoke:bedrock": "node --env-file-if-exists=../../.env scripts/bedrock-smoke.js",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@flora/shared": "workspace:*",
    "@prisma/client": "^6.19.0",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "vitest": "^4.1.10"
  }
}
