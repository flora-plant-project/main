# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is gitignored and must never be committed. Each teammate keeps their own.

# Local Postgres (docker compose up -d db)
DATABASE_URL=postgresql://flora:flora@localhost:5432/flora

# Host port the db container publishes. Change it (and the port in DATABASE_URL
# above) if something else on your machine already owns 5432 — another project's
# Postgres is the usual culprit.
FLORA_DB_PORT=5432

# NOTE: mobile settings do NOT live here. Expo loads .env from its own project
# root, so every EXPO_PUBLIC_* var belongs in apps/mobile/.env — see
# apps/mobile/.env.example. A copy placed in this file is silently ignored.

# --- apps/api ---------------------------------------------------------------
# Port the API listens on.
PORT=4000

# Plant.id recognition key. Get your own (free tier) at https://web.plant.id —
# per-developer keys keep quotas separate. NEVER prefix this EXPO_PUBLIC_: that
# would inline it into the mobile bundle and publish it.
# Leave blank to use the fixture-backed stub recognizer — no key, no network.
PLANT_ID_API_KEY=

# Plant.id API root. Override to point at a mock server.
PLANT_ID_BASE_URL=https://plant.id/api/v3

# Give up on a recognition call after this long. Mobile stops polling at 90s.
FLORA_RECOGNITION_TIMEOUT_MS=45000

# Largest accepted image, in bytes, decoded. Applies to both upload paths: the
# size a client declares to POST /uploads, and an inline base64 scan body.
FLORA_MAX_IMAGE_BYTES=6291456

# --- uploaded photos --------------------------------------------------------
# Blank bucket = photos are stored on local disk and served by the API itself,
# which is what makes uploads work with no AWS account and no network. Set a
# bucket (and the base URL below) to switch to S3; nothing else changes, because
# the database stores keys and URLs are built at read time.
FLORA_S3_BUCKET=
AWS_REGION=eu-north-1

# Credentials for the bucket, when the API runs OUTSIDE AWS. The media stack
# issues these into Secrets Manager (output: MediaApiCredentialsSecret) —
# read them out with 'aws secretsmanager get-secret-value --secret-id <name>'.
# SECRET: never commit, never EXPO_PUBLIC_-prefix. Running on ECS/App Runner
# instead? Leave both blank and let the task role supply credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Where photos are READ from. With S3 this is the CloudFront domain in front of
# the bucket (infra outputs it as MediaBaseUrl) and it is REQUIRED — the API
# refuses to start without it. Locally, blank means http://localhost:$PORT,
# which is right for a simulator; on a physical phone set your LAN address, e.g.
# http://192.168.1.20:4000, or the photos will not load.
FLORA_MEDIA_BASE_URL=

# Where the local driver keeps bytes, relative to apps/api. Gitignored.
FLORA_UPLOAD_DIR=.uploads

# Signs local upload URLs. Dev-only: with S3 the signing is AWS SigV4 instead.
FLORA_UPLOAD_SECRET=flora-local-upload-secret

# How long a signed upload URL stays valid, in ms.
FLORA_UPLOAD_URL_TTL_MS=900000

# Which canned response the stub replays: healthy-basil | diseased-tomato | blurry
FLORA_STUB_FIXTURE=healthy-basil

# --- apps/api: Gemini ---------------------------------------------------------
# Which service answers when the LLM is on: gemini | bedrock. Defaults to
# bedrock, so a checkout that predates Gemini behaves exactly as it did.
FLORA_LLM_PROVIDER=gemini

# Gemini API key, from https://aistudio.google.com/apikey. A real secret, unlike
# the Bedrock path's ambient AWS chain: NEVER give this an EXPO_PUBLIC_ name, or
# it is inlined into the mobile bundle and published. Blank falls back to the
# fixture stub rather than failing to boot.
GEMINI_API_KEY=

# Gemini model id. Do NOT put a gemini-2.5-* id here: Google has closed that
# generation to new API keys, and a key issued today answers 404 naming
# gemini-3.6-flash as the replacement. gemini-3.5-flash-lite is cheaper/faster.
FLORA_GEMINI_MODEL=gemini-3.6-flash

# --- apps/api: Bedrock LLM ---------------------------------------------------
# Care advice and drafted community posts are written by an OpenAI gpt-oss model
# on Amazon Bedrock. Set to 1 to make real calls; anything else replays fixtures
# from test/fixtures/llm-*.json — no AWS account, no model access, no spend.
# Credentials come from the standard AWS chain, so there is no key to set here.
# Verify a real call with: FLORA_LLM_ENABLED=1 pnpm -F api smoke:bedrock
FLORA_LLM_ENABLED=

# Region the Bedrock calls go to. Model access must be requested per-region in
# the Bedrock console first. gpt-oss is in-region only — there is no global or
# geo cross-region endpoint, so this must name a region that hosts the model
# (us-east-1, us-east-2, us-west-2, eu-west-1, eu-central-1 and others).
FLORA_BEDROCK_REGION=us-east-1

# Bedrock model id. openai.gpt-oss-20b-1:0 is the smaller, cheaper, faster
# sibling — worth trying if advice quality holds up.
FLORA_BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0

# Give up on one model call after this long.
FLORA_LLM_TIMEOUT_MS=30000

# Artificial latency for the stub recognizer, in ms. 0 (default) answers
# instantly. The live contract suite sets this: a provider with no latency never
# lets a client observe the PENDING state it is supposed to poll through.
FLORA_STUB_DELAY_MS=0
